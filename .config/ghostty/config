background = #000000

font-family = IoskeleyMonoTerm Nerd Font
font-size = 14

window-decoration = true
resize-overlay = never
macos-option-as-alt = true
macos-titlebar-style = tabs

shell-integration = zsh
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path

# add some padding on top to make room for the rounded corners
# where the title bar normally would be.
window-padding-y = 7,0

# Adjusted 16 color palette.
palette =  0=#000000
palette =  1=#ec392c
palette =  2=#b3e439
palette =  3=#fea525
palette =  4=#cfa3ff
palette =  5=#fd4285
palette =  6=#76dff3
palette =  7=#f4f4f4
palette =  8=#676767
palette =  9=#ff4036
palette = 10=#c5fa41
palette = 11=#ffb450
palette = 12=#dfc2ff
palette = 13=#ff679f
palette = 14=#9aefff
palette = 15=#feffff

split-divider-color = #444444

palette-generate = true

# bold colors are brighter.
# necessary to make comments in zsh (black on black) readable.
bold-is-bright = true

