diff --git a/submission.py b/submission.py
new file mode 100644
--- /dev/null
+++ b/submission.py
@@ -0,0 +1,9 @@
+class SubmissionRuntime:
+    def __init__(self, journal):
+        self.journal = journal
+
+    async def submit(self, batch, *, durable):
+        receipt = await self.journal.append(batch)
+        if durable:
+            await receipt.committed()
+        return receipt.id
