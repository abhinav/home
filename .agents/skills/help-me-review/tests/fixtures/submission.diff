diff --git a/test_submission.py b/test_submission.py
--- a/test_submission.py
+++ b/test_submission.py
@@ -1,4 +1,16 @@
-async def test_upload(store, request):
-    response = await upload(request, store)
+async def test_upload(journal, request):
+    journal.pause_commits()
+    runtime = SubmissionRuntime(journal)
+    response = await upload(request, runtime)
     assert response.status == 202
-    assert await store.read(response.body["receipt"]) == request.batch
+    assert journal.pending(response.body["receipt"]) == request.batch
+
+async def test_replay(staged, journal):
+    journal.pause_commits()
+    runtime = SubmissionRuntime(journal)
+    task = start(replay(staged, runtime))
+    await journal.wait_for_append()
+    assert staged.exists()
+    journal.resume_commits()
+    await task
+    assert not staged.exists()
diff --git a/README.md b/README.md
--- a/README.md
+++ b/README.md
@@ -1,4 +1,5 @@
 # Submission API
 
-A 202 response means the submitted batch is durable.
-The receipt identifies the stored batch.
+A 202 response means the submitted batch was admitted to the journal.
+Poll the receipt until committed before discarding the source batch.
+The shared runtime also supports waiting for commitment during recovery.
